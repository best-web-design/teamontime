# MySQL / MariaDB (DirectAdmin → MySQL Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# First admin login, created on first start when no admin exists (10+ char password)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 1 = keep the site out of search engines (staging). Remove for the live domain.
SITE_NOINDEX=
# Fallback site URL if not set in Admin → Settings
SITE_URL=
# Optional: email notifications for form submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# Optional: where uploaded images are stored (default ./uploads)
UPLOAD_DIR=
