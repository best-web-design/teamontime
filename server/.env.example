# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bwd?retryWrites=true&w=majority
PORT=4000
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Public URL of this API (used in uploaded image URLs)
PUBLIC_API_URL=https://api.bestwebdesign.co.za
# Comma-separated origins allowed to call the API (the website)
CORS_ORIGIN=https://bestwebdesign.co.za
# Website URL + shared secret so admin saves refresh the site instantly
WEB_URL=https://bestwebdesign.co.za
REVALIDATE_SECRET=
# Optional: email notifications for form submissions
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
# Used once by `npm run seed` to create the admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
